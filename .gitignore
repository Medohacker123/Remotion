node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# The delivered master MP4 (~31 MB) is generated by `npm run render:final`.
# public/out/ and artifacts/ stay untracked (regenerate with the pipeline), but
# deliverables/ IS tracked on purpose: it is the copy that is downloadable
# straight from GitHub for people who only have a phone and no server.
public/out/*.mp4
artifacts/*.mp4

# intermediate render artifacts (the delivered MP4 lives in public/out/)
build/frames/
build/frames-4k/
build/footage/
build/preview*/
build/verification/
build/work/
build/render-assets/
